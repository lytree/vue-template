# vue@3.6.0-rc.7 是预发布版本，无法满足 element-plus / pinia / vue-router
# 声明的 "^3.5.x" peer 范围（semver 规定预发布版本不匹配普通范围）。
#
# pnpm 默认不会因 peer 不匹配而中断安装（只告警），这里显式关闭严格校验；
# auto-install-peers 会自动补装缺失的 peer，消除"幽灵依赖"告警。
#
# 注意：npm 的 legacy-peer-deps 在 pnpm 下无效，切勿保留。
strict-peer-dependencies=false
auto-install-peers=true
