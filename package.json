{
  "name": "vue-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Vue 3 + TSX + Vite admin template, styled after Ant Design 5",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "create:page": "node scripts/create-page.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "3.6.0-rc.7",
    "vue-jsx": "3.3.0-rc.2",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "sass": "^1.105.0",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.2.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
